# Apply only after final source assembly; remove relative and absolute duplicates.
include("${CMAKE_CURRENT_LIST_DIR}/../../build_profiles.cmake")
list(APPEND SOURCES "${CMAKE_CURRENT_LIST_DIR}/no_music_callbacks.cc")
set(STACKCHAN_MUSE_PROTOCOL_REQUIREMENT "")
if(STACKCHAN_PROFILE_MUSE STREQUAL "1")
    list(APPEND STACKCHAN_MUSE_PROTOCOL_REQUIREMENT muse_direct_protocol)
elseif(EXISTS "${CMAKE_CURRENT_LIST_DIR}/../feature_profiles/muse_disabled_boundary.cc")
    list(APPEND SOURCES "${CMAKE_CURRENT_LIST_DIR}/../feature_profiles/muse_disabled_boundary.cc")
endif()
set(profile_sources)
foreach(unit IN LISTS SOURCES)
    get_filename_component(absolute_unit "${unit}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    file(RELATIVE_PATH relative_unit "${CMAKE_CURRENT_SOURCE_DIR}" "${absolute_unit}")
    if(NOT relative_unit IN_LIST STACKCHAN_PROFILE_EXCLUDED_SOURCES)
        list(APPEND profile_sources "${unit}")
    endif()
endforeach()
set(SOURCES "${profile_sources}")
